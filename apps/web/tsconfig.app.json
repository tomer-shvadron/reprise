{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": ".tsbuild/app",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "e2e/visual"],
  // Node-side: the visual suite's global setup and browser commands, in tsconfig.node.json.
  "exclude": ["e2e/**/*.node.ts"],
  "references": [
    { "path": "../../packages/model" },
    { "path": "../../packages/formats" },
    { "path": "../../packages/layout" },
    { "path": "../../packages/audio" }
  ]
}
