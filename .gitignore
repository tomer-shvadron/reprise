# dependencies
node_modules/
# pnpm-lock.yaml is the one lockfile; another package manager's never gets committed
package-lock.json
npm-shrinkwrap.json
yarn.lock
bun.lock
bun.lockb

# build output
dist/
out/
release/
*.tsbuildinfo
.tsbuild/
.vite/

# tests
coverage/
playwright-report/
test-results/
.vitest/
# visual baselines are CI's Linux images; a developer's own references stay local
apps/web/e2e/visual/__local__/
# the player flows' scores, written by their global setup
apps/web/e2e/player/.generated/

# local only
local-tabs/*
!local-tabs/README.md
.env
.env.*
.DS_Store

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# sound banks, fetched by `pnpm sounds:fetch`
apps/web/public/sounds/gm/*
!apps/web/public/sounds/gm/README.md

# downloaded SFZ packs, for `pnpm sfz:check` and manual testing; never committed
local-sounds/*
!local-sounds/README.md

# the real-file pass, `pnpm check:files`
.check-files/

# per-developer Claude Code settings
.claude/settings.local.json
