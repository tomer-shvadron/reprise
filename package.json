{
  "name": "reprise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @reprise/web dev",
    "build": "pnpm --filter @reprise/web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run --config apps/web/vitest.visual.config.ts",
    "visual:accept": "node scripts/visual/accept.ts",
    "bench": "vitest bench --reporter=verbose --reporter=./scripts/bench/budget-reporter.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:describe": "node scripts/fixtures/describe.ts",
    "fixtures:check": "node scripts/fixtures/describe.ts --check",
    "sounds:fetch": "node scripts/sounds/fetch-gm.ts",
    "sounds:fixture": "node scripts/sounds/make-test-sf2.ts",
    "layout:metrics": "node scripts/layout/metrics.ts",
    "layout:metrics:check": "node scripts/layout/metrics.ts --check",
    "e2e": "playwright test --config apps/web/playwright.config.ts",
    "desktop:dev": "pnpm --filter @reprise/desktop dev",
    "desktop:build": "pnpm --filter @reprise/desktop build",
    "desktop:smoke": "node scripts/desktop/smoke.ts",
    "prepare": "husky",
    "postinstall": "playwright install chromium --only-shell"
  },
  "devDependencies": {
    "@coderline/alphatab": "1.8.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@reprise/formats": "workspace:*",
    "@reprise/model": "workspace:*",
    "@types/fontkit": "2.0.9",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "fontkit": "2.0.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
